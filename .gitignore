# Secrets
.env
.env.*
!.env.example

# Virtual environments
venv/
.venv/
env/

# Data
data/raw/*
!data/raw/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# Large artifacts
*.ckpt
*.pt
*.pth

# OS / editors
.DS_Store
.vscode/
.idea/

# LaTeX build files
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz

# Processed data: keep small metadata/splits, not the big graph files
data/processed/**/*.tsv.gz

# Large LLM provenance logs (archive separately, e.g. Zenodo)
results/runs/llm/**/*.jsonl

# live LLM run logs
results/logs/llm_*.log

# TxGNN baseline: isolated env + upstream code
.venv-txgnn/
third_party/
data/processed/txgnn*/
results/runs/txgnn/**/model/
results/runs/txgnn/**/*.npz
results/runs/txgnn/**/*.pkl
